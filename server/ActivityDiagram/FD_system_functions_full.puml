  rectangle "Doi mat khau" as F_ChangePassword #DCFCE7
  rectangle "Cap nhat thong tin ca nhan" as F_Profile #DCFCE7
  rectangle "Doi email / so dien thoai bang OTP" as F_ChangeContact #DCFCE7
  rectangle "Xac thuc CCCD chu tro" as F_Cccd #DCFCE7
}

