@startuml
title So do chuc nang tong the - He thong NestFinder / Quan ly phong tro

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam rectangle {
  BorderColor #CBD5E1
  FontColor #0F172A
}

left to right direction

actor "Khach truy cap" as Guest
actor "Nguoi thue" as Tenant
actor "Chu tro" as Landlord
actor "Quan tri vien" as Admin
actor "Cong thanh toan\nMoMo / VNPay" as PaymentGateway
actor "Dich vu ngoai\nCloudinary / Email / AI" as ExternalService

rectangle "HE THONG NESTFINDER\nTIM KIEM VA QUAN LY PHONG TRO" as System #2563EB

package "1. Tai khoan va xac thuc" as AuthPkg {
  rectangle "Dang ky tai khoan" as F_Register #DCFCE7
  rectangle "Gui va xac thuc OTP dang ky" as F_RegisterOtp #DCFCE7
  rectangle "Dang nhap Email/Mat khau" as F_Login #DCFCE7
  rectangle "Dang nhap Google" as F_GoogleLogin #DCFCE7
  rectangle "Kiem tra phien dang nhap" as F_Auth #DCFCE7
  rectangle "Lam moi token / Dang xuat" as F_Token #DCFCE7
