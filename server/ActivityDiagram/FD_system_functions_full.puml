  rectangle "Admin gui thong bao broadcast" as F_Broadcast #ECFCCB
  rectangle "Quan ly banner khuyen mai" as F_Banner #ECFCCB
}

package "8. Quan tri he thong" as AdminPkg {
  rectangle "Dashboard thong ke tong quan" as F_AdminStats #FEE2E2
