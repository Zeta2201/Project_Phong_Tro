  rectangle "Quan ly goi dang tin" as F_PostingPlan #E0F2FE
  rectangle "Quan ly voucher giam gia" as F_Voucher #E0F2FE
  rectangle "Xem diem thuong va hang thanh vien" as F_RewardMe #E0F2FE
  rectangle "Doi diem lay voucher" as F_RedeemReward #E0F2FE
  rectangle "Xem lich su diem / voucher cua toi" as F_RewardHistory #E0F2FE
}

package "7. Thong bao va truyen thong" as NotifyPkg {
  rectangle "Nhan thong bao ca nhan" as F_Notifications #ECFCCB
  rectangle "Dem thong bao chua doc" as F_UnreadCount #ECFCCB
