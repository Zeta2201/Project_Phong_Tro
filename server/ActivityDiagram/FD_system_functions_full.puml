  rectangle "Quan ly lien he" as F_AdminContacts #FEE2E2
  rectangle "Quan ly giao dich nap tien" as F_AdminRecharge #FEE2E2
  rectangle "Quan ly giao dich coc va tranh chap" as F_AdminDeposits #FEE2E2
  rectangle "Quan ly hop dong" as F_AdminContracts #FEE2E2
  rectangle "Quan ly bo loc" as F_AdminFilters #FEE2E2
  rectangle "Quan ly voucher va goi dang tin" as F_AdminCommercial #FEE2E2
  rectangle "Quan ly tich diem va voucher diem" as F_AdminRewards #FEE2E2
  rectangle "Quan ly banner va thong bao" as F_AdminBroadcast #FEE2E2
}

